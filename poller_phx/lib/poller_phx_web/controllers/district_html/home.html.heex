<Layouts.flash_group flash={@flash} />
<div class="px-4 py-10 sm:px-6 sm:py-28 lg:px-8 xl:px-28 xl:py-32">
  <div class="mx-auto lg:mx-0">
    <h1 class="text-2xl font-semibold leading-10 tracking-tight">
      Districts
    </h1>
    
    <table class="mt-8 w-full divide-y divide-gray-200 border">
      <thead class="bg-gray-50 w-full">
        <tr class="flex">
          <th class="px-4 py-2 text-left text-sm font-medium text-gray-500">ID</th>
          <th class="flex-1 px-4 py-2 text-left text-sm font-medium text-gray-500">Name</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <%= for district <- @districts do %>
          <tr class="flex">
            <td class="px-4 py-2 text-sm text-gray-100"><%= district.id %></td>
            <td class="flex-1 px-4 py-2 text-sm text-gray-200"><%= district.name %></td>
            <td class="px-4 py-2 text-sm text-gray-100">...</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
