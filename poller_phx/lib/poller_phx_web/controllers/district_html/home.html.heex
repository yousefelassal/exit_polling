<Layouts.app flash={@flash}>
<Layouts.flash_group flash={@flash} />
  <div class="mx-auto lg:mx-0">
    <div class="flex items-center justify-between gap-x-3">
      <h2 class="text-lg font-semibold leading-8 tracking-tight text-gray-200">Districts</h2>
      <.button navigate={~p"/districts/new"}>New</.button>
    </div>
    
    <table class="mt-8 w-full divide-y divide-gray-200 border">
      <thead class="bg-gray-50 w-full">
        <tr class="flex">
          <th class="px-4 py-2 text-left text-sm font-medium text-gray-500">ID</th>
          <th class="flex-1 px-4 py-2 text-left text-sm font-medium text-gray-500">Name</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <%= for district <- @districts do %>
          <tr class="flex">
            <td class="px-4 py-2 text-sm text-gray-100"><%= district.id %></td>
            <td class="flex-1 px-4 py-2 text-sm text-gray-200"><%= district.name %></td>
            <td class="px-4 py-2 text-sm text-gray-100">...</td>
          </tr>
        <% end %>
      </tbody>
    </table>
    
    <%!-- <.table id="districts" rows={@districts}>
      <:col :let={district} label="id">{district.id}</:col>
      <:col :let={district} label="name">{district.name}</:col>
      <:col :let={district} label="">...</:col>
    </.table> --%>
  </div>
</Layouts.app>